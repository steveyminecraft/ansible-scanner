---
extends: default
ignore: |
  .venv/
  .ansible/
  .pytest_cache/
rules:
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  line-length:
    max: 160
    allow-non-breakable-words: true
  comments:
    min-spaces-from-content: 1
  braces:
    max-spaces-inside: 1
  truthy:
    allowed-values: ["true", "false"]
